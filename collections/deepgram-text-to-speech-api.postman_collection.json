{
  "item": [
    {
      "id": "c703fae6-ef28-4de9-848c-97c9e6f2e4af",
      "name": "Text-To-Speech",
      "description": {
        "content": "Convert text into natural-sounding speech audio.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "410a144e-8499-44ac-99b3-b6b3c638d252",
          "name": "Deepgram Convert text to speech",
          "request": {
            "name": "Deepgram Convert text to speech",
            "description": {
              "content": "Converts text content into natural-sounding speech audio using Deepgram's Aura model family. Returns audio data in the specified encoding format. Supports multiple voices and configurable audio output settings including encoding, sample rate, and container format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "speak"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "model",
                  "value": "aura-asteria-en",
                  "description": "Voice model to use for speech synthesis. Aura model family voices include aura-asteria-en, aura-luna-en, aura-stella-en, aura-athena-en, aura-hera-en, aura-orion-en, aura-arcas-en, aura-perseus-en, aura-angus-en, aura-orpheus-en, aura-helios-en, and aura-zeus-en."
                },
                {
                  "disabled": false,
                  "key": "encoding",
                  "value": "linear16",
                  "description": "Audio encoding format for the output. Options include linear16, mulaw, alaw, mp3, opus, flac, and aac."
                },
                {
                  "disabled": false,
                  "key": "container",
                  "value": "wav",
                  "description": "File format container for the output audio. The default depends on the encoding selected."
                },
                {
                  "disabled": false,
                  "key": "sample_rate",
                  "value": "24000",
                  "description": "Sample rate in Hertz for the output audio. Default is 24000. Valid values depend on the selected encoding."
                },
                {
                  "disabled": false,
                  "key": "bit_rate",
                  "value": "<integer>",
                  "description": "Bit rate for compressed audio formats such as MP3 and Opus."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<uri>",
                  "description": "URL to which Deepgram will send the audio when processing is complete."
                },
                {
                  "disabled": false,
                  "key": "callback_method",
                  "value": "POST",
                  "description": "HTTP method for the callback request."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "audio/wav"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
